# 이 파일을 .env로 복사하고 실제 키를 넣으세요 (bun이 자동으로 로드합니다)
ANTHROPIC_API_KEY=sk-ant-...

# 실습에 사용할 모델. deprecated 되면 여기만 바꾸면 됩니다 (코드 수정 불필요)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Langfuse (13~15단계). cloud.langfuse.com › 프로젝트 Settings › API Keys 에서 발급
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
